# ---- LLM ------------------------------------------------------------------
# provider: openai | gemini | rule   ("rule" = offline, no API calls)
LLM_PROVIDER=rule
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# only for OpenAI-compatible providers (Groq, Together, NVIDIA NIM, vLLM, ...)
LLM_BASE_URL=

# ---- Embeddings / vector index -------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DB_PATH=models/vector_index

# ---- Data -----------------------------------------------------------------
KNOWLEDGE_DIR=data
DB_PATH=data/retail.db

# ---- Agent limits ---------------------------------------------------------
SQL_MAX_ROWS=200
SQL_TIMEOUT_SECONDS=10
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.15
AUDIT_LOG_PATH=reports/agent_audit.jsonl
